{
  "name": "@cocreate/server-cron",
  "version": "1.10.0",
  "description": "A distributed server-side cron scheduler and orchestrator for CoCreate Server.",
  "keywords": [
    "server-cron",
    "cron-scheduler",
    "scheduler",
    "orchestrator",
    "cron-jobs",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "server"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "A distributed server-side cron scheduler and orchestrator for CoCreate Server.",
      "source": "src/index.js",
      "api": {
        "exports": [
          "addToPlatformDB",
          "executeCronJob",
          "findNextCronJob",
          "getNextExecutionTime",
          "handleCrudEvent",
          "init",
          "pollForCronJobs",
          "scheduleCronJob"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocreatejs/CoCreate-server-cron.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-server-cron/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/server-cron",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/server": "^1.11.0"
  }
}
